<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.fcast.receiver" name="FCast Receiver" version="0.2.0-beta" provider-name="ozankiratli">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="inputstream.adaptive" version="21.5.9"/>
    </requires>
    <extension point="xbmc.service" library="resources/lib/startup.py" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en">FCast Receiver</summary>
        <description lang="en">FCast receiver for Kodi</description>
        <license>GNU General Public License, v2</license>
        <language></language>
        <source>https://github.com/ozankiratli/kodi-fcast-receiver</source>
        <email>ozankiratli@protonmail.com</email>
        <assets>
            <icon>icon.png</icon>
        </assets>
        <news>Fixed dropped connections caused by split packets, which broke Grayjay and other newer senders. Stream request headers are now honoured. mDNS discovery now works on LibreELEC and CoreELEC.</news>
    </extension>
</addon>